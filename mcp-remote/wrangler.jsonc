/**
 * Wrangler config for the kai-planner remote MCP server.
 * Secrets (set via `wrangler secret put`, never committed):
 *   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, COOKIE_ENCRYPTION_KEY
 *   KAI_API_KEY, CF_ACCESS_CLIENT_ID, CF_ACCESS_CLIENT_SECRET
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kai-planner-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    {
      "new_sqlite_classes": ["MyMCP"],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "MyMCP",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "798136fe663d4ebcaef6b73161931761"
    }
  ],
  "vars": {
    "KAI_BASE_URL": "https://kaihoward.com/personal/api",
    "VAPID_SUBJECT": "mailto:kaihoward106@gmail.com",
    "VAPID_PUBLIC_KEY": "BE_Nq51fwZYwrKuHnV2CL_81qDU9P-X5HO2N4yFKF2UnTdDqm5oOt4suhc78DvLxzMp3u2aySImZQ1wC88GO6aI"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  }
}
